{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "wiktorzmegmail.onmicrosoft.com",
    "TenantId": "e7b4669a-95b7-468d-8c55-4ba35609e82b",
    "ClientId": "d9893e35-e104-4218-aa0a-96facb6d5739",
    "CallbackPath": "/signin-oidc",
    "ClientSecret": "",
    "KvUrl": "https://kv-gs-apigateway.vault.azure.net/"
  },
  "ReverseProxy": {
    "Routes": {
      "product-by-type": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/gateway/product/{type}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/Product/{type}"
          }
        ]
      },
      "product-by-type-and-id": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/gateway/product/{type}/{id}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/Product/{type}/{id}"
          }
        ]
      },
      "product-filters": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/gateway/product/{type}/filters",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/Product/{type}/filters"
          }
        ]
      },
      "user-signin": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/gateway/user/signin",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/user/signin"
          }
        ]
      },
      "user-me": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/gateway/user/me",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/user/me"
          }
        ]
      },
      "user-signout": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/gateway/user/signout",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/user/signout"
          }
        ]
      },
      "cart-create": {
        "ClusterId": "cart-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/gateway/cart",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/cart"
          }
        ]
      },
      "cart-get": {
        "ClusterId": "cart-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/gateway/cart",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/cart"
          }
        ]
      }
    },
    "Clusters": {
      "product-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7003"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7002"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cart-api:8080"
          }
        }
      }
    }
  }
}
