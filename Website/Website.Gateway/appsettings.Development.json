{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Keycloak": {
    "Authority": "https://localhost:8080/realms/hardware-nexus",
    "ClientId": "gateway",
    "ClientSecret": "fiYU62dBOZUJHkFy3jDNAOP3Ie9rpdEC"
  },
  "ReverseProxy": {
    "Routes": {
      "product-by-type": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/gateway/product/{type}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/Product/{type}"
          }
        ]
      },
      "product-by-type-and-id": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/gateway/product/{type}/{id}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/Product/{type}/{id}"
          }
        ]
      },
      "product-filters": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/gateway/product/{type}/filters",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/Product/{type}/filters"
          }
        ]
      },
      "cart-create": {
        "ClusterId": "cart-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/gateway/cart",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/cart"
          }
        ]
      },
      "cart-get": {
        "ClusterId": "cart-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/gateway/cart",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/cart"
          }
        ]
      }
    },
    "Clusters": {
      "product-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7003"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7002"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cart-api:8080"
          }
        }
      }
    }
  }
}
